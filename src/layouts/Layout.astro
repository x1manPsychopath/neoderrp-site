---
import '../styles/tokens.css';
const { title = 'NeoDerrp — Derrp Gaming' } = Astro.props;
const links = [
  ['Schedule', '/schedule'], ['Watch', '/#watch'], ['Projects', '/#projects'],
  ['Services', '/services'], ["Ama's Art", '/commissions'], ['About', '/#about'],
];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="icon" href="/wordmark-stacked.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap header-in">
      <a class="brand" href="/">
        <img src="/wordmark-header.png" alt="NeoDerrp" height="46" />
      </a>
      <nav>{links.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="site-footer">
    <div class="wrap footer-in">
      <img src="/wordmark-header.png" alt="" height="38" />
      <p><strong>Derrp Gaming</strong> · Cozy gaming, IT, and building things together.<br />
      NeoDerrp Mon/Wed/Fri · AmaDerrp Tue/Thu/Sun · All times ET · Lurkers welcome</p>
    </div>
  </footer>
</body>
</html>
