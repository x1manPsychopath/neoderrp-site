---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const videos = (await getCollection('videos')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const projectEntries = await getCollection('projects');
// Home — Webflow sketch Part 2, polished pass.
// Live/next-stream status should be wired to Derrp Command Center data
// or a weekly static update — never hand-faked.
const week = [
  { day: 'Monday', who: 'NeoDerrp', ama: false, what: 'Main Quest Monday ⚔️' },
  { day: 'Tuesday', who: 'AmaDerrp', ama: true, what: 'Adventure Tuesday 🪿' },
  { day: 'Wednesday', who: 'NeoDerrp', ama: false, what: 'Unfinished Business 🔍' },
  { day: 'Thursday', who: 'AmaDerrp', ama: true, what: 'Thursday Flex 🎨' },
  { day: 'Friday', who: 'NeoDerrp', ama: false, what: 'Community Quest Friday 🎲' },
  { day: 'Sunday', who: 'AmaDerrp', ama: true, what: 'Art n Goose Shenanigans 🌙' },
];
const projects = projectEntries.map((p) => ({ name: p.data.name, blurb: p.data.summary, status: p.data.status }));
---
<Layout>
  <div class="hero">
    <p class="eyebrow">🌙 Derrp Gaming presents</p>
    <h1>Cozy gaming, IT, and building things together.</h1>
    <p class="lede">Gaming, tech, learning new things, and a community that shows up for each other. Lurkers welcome — always.</p>
    <div class="cta-row">
      <a class="cta" href="https://twitch.tv/neoderrp">Watch on Twitch</a>
      <a class="cta secondary" href="/schedule">This week's schedule</a>
    </div>
  </div>

  <section>
    <h2>This week at the Derrps</h2>
    <div class="grid">
      {week.map((n) => (
        <article class="card">
          <div class="day">{n.day}</div>
          <span class={n.ama ? 'pill ama' : 'pill'}>{n.who}</span>
          <p style="margin:.6em 0 .2em">{n.what}</p>
          <p class="time">5:00–10:00 PM ET · Twitch</p>
        </article>
      ))}
    </div>
    <p class="muted" style="margin-top:14px">Saturday is protected family / flex time — no stream by default.</p>
  </section>

  <section id="watch">
    <h2>Latest videos &amp; VODs</h2>
    <div class="grid">
      {videos.map((v) => (
        <article class="card">
          <div class="day"><a href={v.data.url}>{v.data.gameOrProject ?? v.data.platform}</a></div>
          <p class="muted" style="margin:.4em 0">{v.data.title}</p>
          <p class="time">{v.data.platform} · {v.data.publishDate.toISOString().slice(0, 10)}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="projects">
    <h2>What I'm building</h2>
    <div class="grid">
      {projects.map((p) => (
        <article class="card"><div class="day">{p.name}</div><p class="muted" style="margin:.4em 0 0">{p.blurb}</p></article>
      ))}
    </div>
  </section>

  <section id="about">
    <h2>Work with me</h2>
    <p class="muted">Game server setup and remote IT support, with the same care I put into my own rigs.</p>
    <div class="cta-row"><a class="cta" href="/services">See services</a></div>
  </section>
</Layout>
